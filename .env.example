# Local development environment for hepsearch.
#
# Copy to `.env` and edit if you need to change anything:
#     cp .env.example .env
#
# Copying is OPTIONAL. Every variable below is also declared with the same
# default inside compose.yaml, so `docker compose up -d` works on a fresh clone
# with no `.env` file at all.
#
# These values are LOCAL DEVELOPMENT PLACEHOLDERS. The database binds to
# localhost and holds only public INSPIRE metadata. Never put a real credential
# in this file - `.env.example` is committed, `.env` is git-ignored.

# --- Consumed by the PostgreSQL container -----------------------------------
# These three are passed into the container; the image entrypoint reads them on
# first initialisation to create the role and the database.
POSTGRES_DB=hepsearch
POSTGRES_USER=hepsearch
POSTGRES_PASSWORD=hepsearch

# --- Host-side only: how the HOST reaches the container ---------------------
# Django runs on the host (Compose runs the database only - see AGENTS.md §2),
# so "host" and "port" describe how a host process connects, NOT how the
# container configures itself. These two are deliberately NOT passed into the
# container's `environment:` block.
#
# The container always listens on 5432 internally. POSTGRES_PORT is the port
# published on the host, and 5433 is used instead of the default 5432 so that a
# contributor with PostgreSQL already installed locally does not get a conflict.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# --- Note for HS-003 --------------------------------------------------------
# Django assembles its DATABASES setting from these five variables. There is
# deliberately no DATABASE_URL: the PostgreSQL image entrypoint only understands
# POSTGRES_*, django-environ does not expand variables inside .env, and neither
# form can be derived from the other - so storing both would duplicate the
# credentials and let them drift.
